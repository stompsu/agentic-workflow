# syntax=docker/dockerfile:1
# Knowledge ingestion job image.  Image name: support-ingestion.
# BUILD CONTEXT IS THE REPOSITORY ROOT (the image bundles the root knowledge/ folder):
#   docker build -f src/backend/Dockerfile.ingestion -t support-ingestion .
# The root .dockerignore applies (src/backend/.dockerignore is only for the API image, context src/backend).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore first (layer cache): only manifests and project files.
COPY src/backend/Directory.Build.props src/backend/Directory.Packages.props ./
COPY src/backend/src/SupportChat.Core/SupportChat.Core.csproj src/SupportChat.Core/
COPY src/backend/src/SupportChat.Infrastructure/SupportChat.Infrastructure.csproj src/SupportChat.Infrastructure/
COPY src/backend/src/SupportChat.Ingestion/SupportChat.Ingestion.csproj src/SupportChat.Ingestion/
RUN dotnet restore src/SupportChat.Ingestion/SupportChat.Ingestion.csproj

COPY src/backend/src/SupportChat.Core/ src/SupportChat.Core/
COPY src/backend/src/SupportChat.Infrastructure/ src/SupportChat.Infrastructure/
COPY src/backend/src/SupportChat.Ingestion/ src/SupportChat.Ingestion/
RUN dotnet publish src/SupportChat.Ingestion/SupportChat.Ingestion.csproj \
      -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
COPY knowledge/ /app/knowledge/

# Non-root: the aspnet image ships an unprivileged "app" user (APP_UID). Knowledge files are read-only for it.
USER $APP_UID
ENV Ingestion__SourcePath=/app/knowledge \
    DOTNET_EnableDiagnostics=0
# Default: ingest /app/knowledge. Extra args (e.g. --dry-run, --allow-empty) can be appended as the container command.
ENTRYPOINT ["dotnet", "SupportChat.Ingestion.dll"]
