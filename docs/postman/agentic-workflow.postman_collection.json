{
  "info": {
    "name": "Agentic Workflow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Backend API (docs/api-contract.md).\n\nQuick start: run **1. Get a token > Guest token**, then **Create session**, then **Send message**. Scripts save `accessToken` and `sessionId` for you.\n\nSigned-in user: sign in to the app in a browser, copy the Bearer token of any `/api/` request from DevTools > Network, and paste it into the `accessToken` collection variable (Current value). Tokens are secrets: do not commit or share them, and do not export the collection with a token in it.\n\n`baseUrl`: the deployed frontend (it proxies `/api/`), or `http://localhost:5080` for a backend running locally."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ca-agentwf-dev-frontend.ashytree-d01db7f0.westeurope.azurecontainerapps.io"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "workflowId",
      "value": "support-ticket"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "message",
      "value": "How long does it take to process a claim?"
    }
  ],
  "item": [
    {
      "name": "1. Get a token",
      "item": [
        {
          "name": "Guest token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guest/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "guest",
                "token"
              ]
            },
            "description": "Anonymous. Creates a NEW guest each call and saves its token as `accessToken`. Only where guest access is enabled (otherwise 404). 429 when the creation limit is hit.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"sessionId\", \"\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Workflows",
      "item": [
        {
          "name": "List workflows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workflows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workflows"
              ]
            },
            "description": "Workflows this user may use. Guests may see fewer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Sessions",
      "item": [
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "description": "Binds a session to `workflowId` and saves its id as `sessionId`. `title` is optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflowId\": \"{{workflowId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"sessionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions?pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "20"
                },
                {
                  "key": "continuationToken",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "The current user's sessions, newest first. To get the next page, enable `continuationToken` and paste the value from the previous response."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get session with messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "The session and its latest 100 messages."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Chat",
      "item": [
        {
          "name": "Send message (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            },
            "description": "Starts a turn. The response is a Server-Sent Events stream (`session`, `agent`, `token`, `citation`, `done` or `error`). Postman shows events as they arrive. A second send during a running turn returns 409 `turn_in_progress`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"{{message}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Delete",
      "item": [
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Deletes the session in `sessionId`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set(\"sessionId\", \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete ALL my data",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me",
                "data"
              ]
            },
            "description": "WARNING: permanently deletes all chat history of the user in `accessToken`, and ends a guest identity. Cannot be undone. 503 `deletion_incomplete` means repeat after `Retry-After`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Health and checks",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "healthz"
              ]
            },
            "description": "Anonymous liveness check through the proxy.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workflows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workflows"
              ]
            },
            "description": "Sent without a token: expects 401 `unauthorized`.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
