<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../AgenticWorkflow.Core/AgenticWorkflow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Agents.AI" />
  </ItemGroup>
  <ItemGroup>
    <!-- Versioned prompt files (ADR 0002 section 7). Logical name = path below the project, e.g. Workflows/SupportTicket/Prompts/orchestrator.v1.md -->
    <EmbeddedResource Include="Workflows/**/*.md" LogicalName="Workflows/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgenticWorkflow.Agents.Tests" />
  </ItemGroup>
</Project>
