{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "AuthMode": "ManagedIdentity"
  },
  "AzureAd": {
    "Instance": "https://<tenant-subdomain>.ciamlogin.com/",
    "TenantId": "<tenant-guid>",
    "ClientId": "<api-app-client-id>"
  },
  "Auth": {
    "RequiredScopes": [ "access_as_user" ]
  },
  "Cosmos": {
    "Endpoint": "https://<account>.documents.azure.com:443/",
    "DatabaseName": "supportchat",
    "ContainerName": "chat"
  },
  "Search": {
    "Endpoint": "https://<service>.search.windows.net",
    "IndexName": "support-knowledge",
    "TopK": 5,
    "MinRerankerScore": 1.5
  },
  "Foundry": {
    "ProjectEndpoint": ""
  },
  "Workflows": {
    "Echo": { "Enabled": false },
    "SupportTicket": {
      "ConfidenceThreshold": 0.7,
      "MaxConsecutiveClarifications": 2,
      "MaxToolCallsPerTurn": 3,
      "Agents": {
        "Orchestrator": { "Deployment": "<chat-deployment-for-orchestrator>" },
        "Policy": { "Deployment": "<chat-deployment>" },
        "Claims": { "Deployment": "<chat-deployment>" },
        "HealthAssessments": { "Deployment": "<chat-deployment>" }
      }
    }
  },
  "Chat": {
    "HistoryMaxMessages": 20,
    "HistoryMaxTokens": 6000,
    "MaxMessageChars": 4000,
    "TurnTimeout": "00:03:00",
    "HeartbeatInterval": "00:00:15",
    "PersistTimeout": "00:00:05",
    "TurnsPerMinute": 10
  }
}
