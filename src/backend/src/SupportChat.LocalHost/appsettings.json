{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "LocalMode": {
    "Auth": "Local",
    "Models": "Scripted",
    "LocalAuth": { "TokenLifetime": "01:00:00" },
    "Scripted": { "TokenDelay": "00:00:00.030" },
    "Knowledge": { "SourcePath": "knowledge" }
  },
  "Workflows": {
    "Echo": { "Enabled": true },
    "SupportTicket": {
      "Agents": {
        "Orchestrator": { "Deployment": "scripted-orchestrator" },
        "Policy": { "Deployment": "scripted-specialist" },
        "Claims": { "Deployment": "scripted-specialist" },
        "HealthAssessments": { "Deployment": "scripted-specialist" }
      }
    }
  }
}
